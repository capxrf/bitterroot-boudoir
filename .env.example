# Create a form at https://formspree.io and paste the form ID (the part after /f/)
PUBLIC_FORMSPREE_ID=your_formspree_id_here

# REQUIRED in production (Cloudflare Pages env vars): set to false or the live site stays Coming Soon + noindex.
# Locally: false to preview the full site. Omit or set true for the Coming Soon gate.
PUBLIC_COMING_SOON=false
