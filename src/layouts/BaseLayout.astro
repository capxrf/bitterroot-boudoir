---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ComingSoon from "../components/ComingSoon.astro";
import { absoluteUrl, business, siteUrl } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** Path or absolute URL for social preview image */
  ogImage?: string;
  /** Extra JSON-LD graph nodes (FAQPage, etc.) */
  schemas?: Record<string, unknown>[];
  /** Set true for 404 and other non-canonical pages */
  noindex?: boolean;
}

const {
  title,
  description = business.description,
  bodyClass = "",
  ogImage = business.defaultOgImage,
  schemas = [],
  noindex = false,
} = Astro.props;

// Temporary gate: set PUBLIC_COMING_SOON=false in .env to preview the full site locally.
const comingSoon = import.meta.env.PUBLIC_COMING_SOON !== "false";

const fullTitle = comingSoon
  ? "Coming Soon | Bitterroot Boudoir"
  : title.includes("Bitterroot Boudoir")
    ? title
    : `${title} | Bitterroot Boudoir`;

const metaDescription = comingSoon
  ? "Bitterroot Boudoir is coming soon — exclusive boudoir photography in Stevensville, Montana."
  : description;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteUrl);
// Prefer clean trailing-slash-free canonicals for indexable pages
if (canonicalURL.pathname.length > 1 && canonicalURL.pathname.endsWith("/")) {
  canonicalURL.pathname = canonicalURL.pathname.slice(0, -1);
}

const ogImageURL = ogImage.startsWith("http")
  ? ogImage
  : absoluteUrl(ogImage);

const shouldNoindex = comingSoon || noindex;

const localBusinessSchema = {
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#business`,
  name: business.name,
  image: absoluteUrl(business.logo),
  url: siteUrl,
  telephone: business.telephone,
  email: business.email,
  description: business.description,
  priceRange: business.priceRange,
  address: {
    "@type": "PostalAddress",
    addressLocality: business.locality,
    addressRegion: business.region,
    addressCountry: business.country,
  },
  areaServed: business.areaServed.map((name) =>
    name === "Bitterroot Valley"
      ? { "@type": "AdministrativeArea", name }
      : { "@type": "City", name },
  ),
  sameAs: [...business.sameAs],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  name: business.name,
  url: siteUrl,
  description: business.description,
  publisher: { "@id": `${siteUrl}/#business` },
  inLanguage: "en-US",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [websiteSchema, localBusinessSchema, ...schemas],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/png" href="/images/brand/logo-mark.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>

    {
      !comingSoon && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body class={comingSoon ? "coming-soon-page" : bodyClass}>
    {
      comingSoon ? (
        <ComingSoon />
      ) : (
        <>
          <Header />
          <main class="site-main">
            <slot />
          </main>
          <Footer />
        </>
      )
    }
  </body>
</html>
