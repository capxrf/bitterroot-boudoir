---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ComingSoon from "../components/ComingSoon.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = "Premium boudoir photography in Stevensville, Montana. Fall in love with the image of yourself.",
  bodyClass = "",
} = Astro.props;

// Temporary gate: set PUBLIC_COMING_SOON=false in .env to preview the full site locally.
const comingSoon = import.meta.env.PUBLIC_COMING_SOON !== "false";

const fullTitle = comingSoon
  ? "Coming Soon | Bitterroot Boudoir"
  : title === "Bitterroot Boudoir"
    ? title
    : `${title} | Bitterroot Boudoir`;

const metaDescription = comingSoon
  ? "Bitterroot Boudoir is coming soon — exclusive boudoir photography in Stevensville, Montana."
  : description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    {comingSoon && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/brand/logo-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body class={comingSoon ? "coming-soon-page" : bodyClass}>
    {
      comingSoon ? (
        <ComingSoon />
      ) : (
        <>
          <Header />
          <main class="site-main">
            <slot />
          </main>
          <Footer />
        </>
      )
    }
  </body>
</html>
