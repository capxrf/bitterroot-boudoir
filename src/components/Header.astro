---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/gallery", label: "Gallery" },
  { href: "/packages", label: "Packages" },
  { href: "/contact", label: "Contact" },
  { href: "/about", label: "The Photographer" },
];
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" data-nav>
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={pathname === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary nav-cta" href="/contact">Book a session</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      backdrop-filter 0.3s var(--ease);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgba(18, 16, 15, 0.9);
    border-bottom-color: var(--line);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    gap: 1rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-nav ul {
    display: flex;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .site-nav a[aria-current="page"] {
    color: var(--accent);
  }

  .nav-cta {
    min-height: 2.5rem;
    padding-inline: 1.15rem;
    font-size: 0.84rem;
  }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: pointer;
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    margin: 0 auto;
    background: var(--ink);
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: "";
  }

  .nav-toggle-bars::before {
    transform: translateY(-5px);
  }

  .nav-toggle-bars::after {
    transform: translateY(3.5px);
  }

  .site-header.is-open .nav-toggle-bars {
    background: transparent;
  }

  .site-header.is-open .nav-toggle-bars::before {
    transform: translateY(0) rotate(45deg);
  }

  .site-header.is-open .nav-toggle-bars::after {
    transform: translateY(-1.5px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .header-inner {
      width: 100%;
      max-width: none;
      margin-inline: 0;
      padding-inline: 0;
    }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .site-nav {
      position: fixed;
      inset: var(--nav-h) 0 auto;
      width: 100%;
      display: grid;
      gap: 1.5rem;
      padding: 1.5rem 1rem;
      background: rgba(18, 16, 15, 0.97);
      border-bottom: 1px solid var(--line);
      transform: translateY(-0.5rem);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
    }

    .site-header.is-open .site-nav {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 1rem;
    }

    .nav-cta {
      width: 100%;
    }
  }
</style>

<script>
  const header = document.querySelector("[data-header]");
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector("[data-nav]");

  const setScrolled = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 12);
  };

  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  toggle?.addEventListener("click", () => {
    const open = header?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      header?.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
