---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-row">
      <img
        class="footer-logo"
        src="/images/brand/logo-full.png"
        alt="Bitterroot Boudoir"
        width="1800"
        height="1180"
      />
      <nav class="footer-links" aria-label="Footer">
        <a href="/gallery">Gallery</a>
        <a href="/packages">Packages</a>
        <a href="/contact">Contact</a>
        <a href="/about">The Photographer</a>
      </nav>
    </div>
    <p class="footer-meta">
      Stevensville, Montana
      <span aria-hidden="true">·</span>
      &copy; {year} Bitterroot Boudoir
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.28);
    padding: 1rem 0 0.55rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    flex-wrap: wrap;
  }

  .footer-logo {
    display: block;
    height: 6.75rem;
    width: auto;
    flex-shrink: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1.15rem;
  }

  .footer-links a {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .footer-meta {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.2;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    text-align: center;
  }

  .footer-meta span {
    margin-inline: 0.4rem;
    opacity: 0.55;
  }

  @media (max-width: 720px) {
    .footer-logo {
      height: 5.25rem;
    }

    .footer-row {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .footer-links {
      justify-content: center;
    }

    .site-footer {
      padding: 0.9rem 0 0.5rem;
    }
  }
</style>
