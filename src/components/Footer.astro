---
import { business } from "../lib/site";

const year = new Date().getFullYear();

const instagramUrl = business.sameAs[0];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-row">
      <div class="footer-brand">
        <img
          class="footer-logo"
          src="/images/brand/logo-full.png"
          alt="Bitterroot Boudoir"
          width="600"
          height="394"
        />
        <div class="footer-socials">
          <a
            class="footer-social footer-social-instagram"
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Bitterroot Boudoir on Instagram"
          >
            <svg
              class="footer-social-icon"
              viewBox="0 0 24 24"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path>
            </svg>
          </a>
          <span
            class="footer-social footer-social-facebook is-disabled"
            aria-label="Facebook coming soon"
            title="Facebook coming soon"
          >
            <svg
              class="footer-social-icon"
              viewBox="0 0 24 24"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
              ></path>
            </svg>
          </span>
        </div>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/gallery">Gallery</a>
        <a href="/packages">Packages</a>
        <a href="/faqs">FAQs</a>
        <a href="/contact">Contact</a>
        <a href="/about">The Photographer</a>
      </nav>
    </div>
    <p class="footer-meta">
      Based in Stevensville, MT
      <span aria-hidden="true">·</span>
      Serving {business.serviceAreaText}
      <span aria-hidden="true">·</span>
      <a class="footer-meta-link" href={`tel:${business.telephone}`}
        >{business.telephoneDisplay}</a
      >
      <span aria-hidden="true">·</span>
      <a class="footer-meta-link" href="/privacy">Privacy</a>
      <span aria-hidden="true">·</span>
      &copy; {year} {business.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.28);
    padding: 1rem 0 0.55rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .footer-logo {
    display: block;
    height: 6.75rem;
    width: auto;
    flex-shrink: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1.15rem;
  }

  .footer-links a {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    transition:
      color 0.25s var(--ease),
      background 0.25s var(--ease),
      border-color 0.25s var(--ease),
      filter 0.25s var(--ease);
  }

  .footer-social-instagram {
    color: #fff;
    background: linear-gradient(
      45deg,
      #f58529,
      #dd2a7b 50%,
      #8134af 80%,
      #515bd4
    );
    border-color: transparent;
  }

  .footer-social-facebook {
    color: #fff;
    background: #1877f2;
    border-color: #1877f2;
  }

  .footer-social:hover {
    filter: brightness(1.08);
  }

  .footer-social.is-disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  .footer-social.is-disabled:hover {
    filter: none;
  }

  .footer-social-icon {
    display: block;
    width: 1.2rem;
    height: 1.2rem;
  }

  .footer-meta {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }

  .footer-meta span {
    margin-inline: 0.4rem;
    opacity: 0.55;
  }

  .footer-meta-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-color: rgba(181, 169, 160, 0.45);
  }

  .footer-meta-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  @media (max-width: 720px) {
    .footer-logo {
      height: 5.25rem;
    }

    .footer-row {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .footer-links {
      justify-content: center;
    }

    .site-footer {
      padding: 0.9rem 0 0.5rem;
    }
  }
</style>
