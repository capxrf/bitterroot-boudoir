---
const year = new Date().getFullYear();
---

<section class="coming-soon" aria-labelledby="coming-soon-title">
  <div class="coming-soon-media" aria-hidden="true">
    <img
      class="coming-soon-image"
      src="/images/home/hero.webp"
      alt=""
      width="7364"
      height="4142"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="coming-soon-veil"></div>
  </div>

  <div class="coming-soon-copy">
    <img
      class="coming-soon-logo"
      src="/images/brand/logo-full.png"
      alt="Bitterroot Boudoir"
      width="1800"
      height="1180"
    />
    <h1 id="coming-soon-title">Coming Soon</h1>
    <p class="coming-soon-lede">
      Exclusive boudoir photography based in Stevensville, Montana.
    </p>
    <p class="coming-soon-copy-note">&copy; {year} Bitterroot Boudoir</p>
  </div>
</section>

<style>
  .coming-soon {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--ink);
  }

  .coming-soon-media {
    position: absolute;
    inset: 0;
  }

  .coming-soon-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .coming-soon-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 45%, rgba(10, 9, 8, 0.45), rgba(10, 9, 8, 0.88)),
      linear-gradient(180deg, rgba(10, 9, 8, 0.55), rgba(10, 9, 8, 0.92));
  }

  .coming-soon-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
    padding: 2rem 1.25rem;
    max-width: 36rem;
    animation: coming-soon-in 0.9s var(--ease) both;
  }

  .coming-soon-logo {
    display: block;
    width: min(100%, 22rem);
    height: auto;
    margin-bottom: 0.35rem;
  }

  .coming-soon-copy h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-style: italic;
    color: var(--ink);
  }

  .coming-soon-lede {
    margin: 0;
    max-width: 22rem;
    color: rgba(242, 235, 228, 0.82);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
  }

  .coming-soon-copy-note {
    margin: 0.65rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  @keyframes coming-soon-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coming-soon-copy {
      animation: none;
    }
  }
</style>
