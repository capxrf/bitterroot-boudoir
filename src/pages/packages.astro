---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";


const everySession = [
  "Pre-session intro call and creative planning",
  "Private venue matched to your theme and mood",
  "Fully guided posing and direction throughout",
  "Professional photo capture with top-of-the-line equipment",
  "Curated image selection and professional retouching",
  "Private gallery reveal to choose your finished artwork",
];

const packages = [
  {
    name: "Essential",
    price: "$1,095",
    summary: "One focused look and a polished starter set of prints.",
    includes: [
      "1 wardrobe / look",
      "~75–90 minute session time",
      "10 individual fully retouched images in a fine-art folio",
    ],
  },
  {
    name: "Signature",
    price: "$1,895",
    summary: "More looks and a complete album. A full story, made to keep.",
    featured: true,
    includes: [
      "2–3 wardrobe / looks",
      "~2 hours of session time",
      "20 fully retouched images in a 10×10 layflat album",
    ],
  },
  {
    name: "Heirloom",
    price: "$2,895",
    summary: "Expanded experience, more looks, a larger album, and credit toward wall art of your choosing.",
    includes: [
      "3–4 wardrobe / looks",
      "~2.5–3 hours of session time",
      "30 fully retouched images in a 12×12 layflat album",
      "$400 credit toward ready-to-hang wall art at your reveal*",
    ],
  },
];

const wallArtCreditNote =
  "*Wall-art credit applies at your reveal toward canvas, metal, acrylic, or framed pieces. If final wall-art selection costs more than the package's included credit amount, you pay the difference. Unused credit has no cash value.";


const addOns = [
  {
    name: "Digital files of your collection",
    detail: "High-resolution files of the same images in your folio or album",
    prices: "Essential — $400\u2003·\u2003Signature — $600\u2003·\u2003Heirloom — $750",
  },

  {
    name: "Additional retouched images",
    detail: "Add favorites beyond your collection count",
    prices: "$75 each\u2003·\u2003five for $325",
  },

  {
    name: "Extra look or overtime",
    detail: "More wardrobe changes or time on set",
    prices: "$150 per 30 minutes",
  },

  {
    name: "More wall art & companion albums",
    detail: "Additional prints, canvases, metal, framing, and second albums",
    prices: "Priced at your reveal",
  },
];
---






<BaseLayout
  title="Boudoir Packages & Pricing | Bitterroot Boudoir"
  description="Boudoir photography packages from $1,095 in Stevensville, MT. Essential, Signature, and Heirloom collections with folio, album, and wall art — serving Hamilton, Missoula, and the Bitterroot Valley."
>
  <section class="page-hero">
    <div class="wrap packages-hero">
      <div class="packages-hero-copy">
        <p class="eyebrow reveal">Standard Packages</p>
        <h1 class="reveal reveal-delay-1">Boudoir packages &amp; pricing.</h1>
        <p class="lede reveal reveal-delay-2">
          Every client gets the same exclusive treatment. Packages differ by how
          many looks/outfits are selected, session length, and which finished artwork you take home — folio,
          album, or album plus wall art. Digital files are optional add-ons after
          your reveal.
        </p>
      </div>
      <div class="packages-hero-media reveal reveal-delay-3">
        <PlaceholderImage
          label="Album / folio sample"
          aspect="4 / 5"
          class="packages-hero-image"
        />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap included">
      <div class="section-head">
        <p class="eyebrow">Every session</p>
        <h2>Included with every booked session</h2>
      </div>
      <ul class="included-list">
        {everySession.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap packages-grid">
      {
        packages.map((pkg) => (
          <article class:list={["package", { featured: pkg.featured }]}>
            <p class="package-note" aria-hidden={pkg.featured ? undefined : "true"}>
              {pkg.featured ? "Most chosen" : "\u00A0"}
            </p>
            <h2>{pkg.name}</h2>
            <p class="package-price">{pkg.price}</p>
            <p class="package-summary">{pkg.summary}</p>
            <ul>
              {pkg.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a class="btn btn-primary" href="/contact">Inquire about {pkg.name}</a>
          </article>
        ))
      }
    </div>
    <div class="wrap">
      <p class="footnote">{wallArtCreditNote}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap hmua">
      <div class="section-head">
        <p class="eyebrow">Strongly Recommended</p>
        <h2>Hair &amp; makeup service - add $150</h2>
      </div>
      <p>
        I work with a fantastic and trusted on-site artist and HIGHLY recommend her services for the
        most flattering, camera-ready results, especially for albums and wall art. The  
        fee goes entirely to the artist. Hair and makeup typically takes ~1hr immediately before the session 
        and also provides a time for us to chat and get to know each other before the shoot. 
        Alternatively, you’re welcome to arrive camera-ready with no artist on site.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap add-ons">
      <div class="section-head">
        <p class="eyebrow">Add-ons</p>
        <h2>After your reveal</h2>
      </div>
      <ul class="add-ons-list">
        {
          addOns.map((item) => (
            <li>
              <strong>{item.name}</strong>
              <span>{item.detail}</span>
              {item.prices && <span class="add-on-prices">{item.prices}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap note">
      <h2>Notes on pricing and package customizations</h2>
      <p>
        Rates reflect venue costs, preparation, professional photography and lighting, retouching, and premimum finished artwork — not
        a rushed photo mini-session. Most clients choose from the Essential, Signature, or
        Heirloom packages. If you already know you want something specific such as a single
        large wall piece, a different album size, or a different mix of final products, tell me
        in your inquiry and we’ll shape a collection and package around that.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/contact">Start with an inquiry</a>
        <a class="btn btn-ghost" href="/faqs">Read the FAQs</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .packages-hero {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  .packages-hero-copy .lede {
    max-width: 34rem;
  }

  .packages-hero-media {
    width: min(100%, 22rem);
    justify-self: start;
  }

  .packages-hero-image {
    width: 100%;
  }

  .packages-grid {
    display: grid;
    gap: 1rem;
  }

  .included .section-head,
  .hmua .section-head,
  .add-ons .section-head,
  .note h2 {
    max-width: none;
  }

  .included-list {
    display: grid;
    gap: 0.55rem 2.5rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-soft);
    list-style-position: outside;
  }

  .hmua p {
    margin: 0;
    max-width: none;
    color: var(--ink-soft);
  }

  .hmua strong {
    color: var(--ink);
    font-weight: 500;
  }

  .package {
    display: grid;
    gap: 0.75rem;
    padding: 1.75rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    align-content: start;
  }

  .package.featured {
    border-color: rgba(var(--accent-rgb), 0.45);
    box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.18);
  }

  .package-note {
    margin: 0;
    min-height: 1.15em;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.15;
    color: var(--accent);
  }

  .package h2 {
    margin: 0;
  }

  .package-price {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--ink);
  }

  .package-summary {
    margin: 0;
  }

  .footnote {
    margin: 1rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .package ul {
    margin: 0.15rem 0 0.35rem;
    padding-left: 1.1rem;
    color: var(--ink-soft);
  }

  .package li + li {
    margin-top: 0.4rem;
  }

  .package .btn {
    justify-self: start;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .add-ons-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem 2.5rem;
  }

  .add-ons-list li {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .add-ons-list strong {
    font-weight: 500;
    color: var(--ink);
  }

  .add-ons-list > li > span {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .add-on-prices {
    margin-top: 0.15rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .note p {
    max-width: none;
  }

  .note .cta-row {
    margin-top: 1.35rem;
  }

  @media (min-width: 700px) {
    .included-list {
      grid-template-columns: 1fr 1fr;
    }

    .add-ons-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 860px) {
    .packages-hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
      align-items: center;
    }

    .packages-hero-media {
      width: 100%;
      max-width: 24rem;
      justify-self: end;
    }
  }

  @media (min-width: 900px) {
    .packages-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
      gap: 1.15rem;
    }
  }
</style>
