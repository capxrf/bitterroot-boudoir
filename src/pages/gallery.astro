---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryLightbox from "../components/GalleryLightbox.astro";
import { getGalleryImages } from "../lib/gallery";

const sourceImages = getGalleryImages();

const images = await Promise.all(
  sourceImages.map(async (image) => {
    const full = await getImage({
      src: image.src,
      width: 2560,
      format: "webp",
      quality: 82,
    });

    return {
      ...image,
      fullSrc: full.src,
      alt: `Boudoir photograph ${image.id} by Bitterroot Boudoir`,
    };
  }),
);
---

<BaseLayout
  title="Gallery"
  description="Browse boudoir photography by Bitterroot Boudoir in Stevensville, Montana."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">Gallery</p>
      <h1 class="reveal reveal-delay-1">Selected work from real sessions.</h1>
      <p class="lede reveal reveal-delay-2">
        Mood, detail, and finishing that define the experience.
      </p>
    </div>
  </section>

  <section class="section-tight gallery-section">
    <div class="wrap">
      {
        images.length === 0 ? (
          <p class="lede">Gallery images coming soon.</p>
        ) : (
          <div class="gallery-grid">
            {images.map((image, index) => (
              <figure class="gallery-item">
                <button
                  type="button"
                  class="gallery-open"
                  data-full={image.fullSrc}
                  data-alt={image.alt}
                  aria-label={`View larger: ${image.alt}`}
                >
                  <Image
                    src={image.src}
                    alt={image.alt}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 980px) 32vw, (min-width: 640px) 48vw, 92vw"
                    quality={80}
                    formats={["avif", "webp"]}
                    loading={index < 6 ? "eager" : "lazy"}
                    decoding="async"
                    class="gallery-photo"
                  />
                </button>
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap cta-band">
      <div>
        <h2>Ready to build your own gallery?</h2>
        <p>Tell me what you want to feel when you see your images.</p>
      </div>
      <a class="btn btn-primary" href="/contact">Start the conversation</a>
    </div>
  </section>

  {images.length > 0 && <GalleryLightbox />}
</BaseLayout>

<style>
  .gallery-grid {
    columns: 1;
    column-gap: 0.85rem;
  }

  .gallery-item {
    break-inside: avoid;
    margin: 0 0 0.85rem;
  }

  .gallery-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    overflow: hidden;
  }

  .gallery-photo {
    width: 100%;
    height: auto;
    vertical-align: middle;
    transition: transform 0.55s var(--ease);
  }

  .gallery-open:hover .gallery-photo,
  .gallery-open:focus-visible .gallery-photo {
    transform: scale(1.03);
  }

  .gallery-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding: var(--space-md);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .cta-band h2 {
    margin-bottom: 0.35em;
  }

  @media (max-width: 720px) {
    .cta-band {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  @media (min-width: 640px) {
    .gallery-grid {
      columns: 2;
    }
  }

  @media (min-width: 980px) {
    .gallery-grid {
      columns: 3;
      column-gap: 1rem;
    }

    .gallery-item {
      margin-bottom: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-open:hover .gallery-photo,
    .gallery-open:focus-visible .gallery-photo {
      transform: none;
    }
  }
</style>
