---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryLightbox from "../components/GalleryLightbox.astro";
import { getGalleryImages } from "../lib/gallery";

const sourceImages = getGalleryImages();

const images = await Promise.all(
  sourceImages.map(async (image) => {
    const full = await getImage({
      src: image.src,
      width: 2560,
      format: "webp",
      quality: 82,
    });

    return {
      ...image,
      fullSrc: full.src,
      alt: `Boudoir photograph ${image.id} by Bitterroot Boudoir`,
    };
  }),
);
---

<BaseLayout
  title="Gallery"
  description="Browse boudoir photography by Bitterroot Boudoir in Stevensville, Montana."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">Gallery</p>
      <h1 class="reveal reveal-delay-1">Selected work from real sessions.</h1>
      <p class="lede reveal reveal-delay-2">
        Mood, detail, and finishing that define the experience.
      </p>
    </div>
  </section>

  <section class="section-tight gallery-section">
    <div class="gallery-shell">
      {
        images.length === 0 ? (
          <p class="lede">Gallery images coming soon.</p>
        ) : (
          <div class="gallery-grid" data-gallery-grid>
            {
              images.map((image, index) => (
                <figure class="gallery-item" data-reading-index={index}>
                  <button
                    type="button"
                    class="gallery-open"
                    data-full={image.fullSrc}
                    data-alt={image.alt}
                    aria-label={`View larger: ${image.alt}`}
                  >
                    <Image
                      src={image.src}
                      alt={image.alt}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 980px) 32vw, (min-width: 640px) 48vw, 92vw"
                      quality={80}
                      formats={["avif", "webp"]}
                      loading={index < 9 ? "eager" : "lazy"}
                      decoding="async"
                      class="gallery-photo"
                    />
                  </button>
                </figure>
              ))
            }
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap cta-band">
      <div>
        <h2>Ready to build your own gallery?</h2>
        <p>Tell me what you want to feel when you see your images.</p>
      </div>
      <a class="btn btn-primary" href="/contact">Start the conversation</a>
    </div>
  </section>

  {images.length > 0 && <GalleryLightbox />}

  {
    images.length > 0 && (
      <script>
        const grid = document.querySelector("[data-gallery-grid]");
        if (grid) {
          let lastCols = 0;
          let resizeTimer;

          function columnCount() {
            if (window.matchMedia("(min-width: 980px)").matches) return 3;
            if (window.matchMedia("(min-width: 640px)").matches) return 2;
            return 1;
          }

          function shortestColumnIndex(columns) {
            let best = 0;
            let bestHeight = Number.POSITIVE_INFINITY;
            columns.forEach((col, index) => {
              const height = col.getBoundingClientRect().height;
              if (height < bestHeight) {
                bestHeight = height;
                best = index;
              }
            });
            return best;
          }

          function layout({ force = false } = {}) {
            const cols = columnCount();
            if (!force && cols === lastCols && grid.dataset.ready === "true") return;
            lastCols = cols;

            const items = [...grid.querySelectorAll(".gallery-item")].sort(
              (a, b) =>
                Number(a.getAttribute("data-reading-index")) -
                Number(b.getAttribute("data-reading-index")),
            );

            grid.querySelectorAll(".gallery-col").forEach((col) => col.remove());

            const columns = Array.from({ length: cols }, () => {
              const col = document.createElement("div");
              col.className = "gallery-col";
              grid.appendChild(col);
              return col;
            });

            // First row stays in reading order across the top.
            items.slice(0, cols).forEach((item, index) => {
              columns[index].appendChild(item);
            });

            // Remaining images fill the shortest column to avoid large gaps.
            items.slice(cols).forEach((item) => {
              columns[shortestColumnIndex(columns)].appendChild(item);
            });

            grid.dataset.ready = "true";
          }

          function relayoutWhenImagesSettle() {
            const imgs = [...grid.querySelectorAll("img")];
            let pending = imgs.filter((img) => !img.complete).length;
            if (pending === 0) {
              layout({ force: true });
              return;
            }

            imgs.forEach((img) => {
              if (img.complete) return;
              const done = () => {
                pending -= 1;
                if (pending <= 0) layout({ force: true });
              };
              img.addEventListener("load", done, { once: true });
              img.addEventListener("error", done, { once: true });
            });
          }

          layout();
          relayoutWhenImagesSettle();
          window.addEventListener(
            "resize",
            () => {
              window.clearTimeout(resizeTimer);
              resizeTimer = window.setTimeout(() => layout({ force: true }), 150);
            },
            { passive: true },
          );
        }
      </script>
    )
  }
</BaseLayout>

<style>
  .gallery-shell {
    width: min(100% - 1.5rem, 94rem);
    margin-inline: auto;
  }

  .gallery-grid {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    opacity: 0;
  }

  .gallery-grid[data-ready="true"] {
    opacity: 1;
    transition: opacity 0.25s var(--ease);
  }

  .gallery-grid :global(.gallery-col) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .gallery-item {
    margin: 0;
  }

  .gallery-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    overflow: hidden;
  }

  .gallery-photo {
    width: 100%;
    height: auto;
    vertical-align: middle;
    transition: transform 0.55s var(--ease);
  }

  .gallery-open:hover .gallery-photo,
  .gallery-open:focus-visible .gallery-photo {
    transform: scale(1.03);
  }

  .gallery-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding: var(--space-md);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .cta-band h2 {
    margin-bottom: 0.35em;
  }

  @media (max-width: 720px) {
    .gallery-shell {
      width: min(100% - 1rem, 94rem);
    }

    .cta-band {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  @media (min-width: 980px) {
    .gallery-grid {
      gap: 0.55rem;
    }

    .gallery-grid :global(.gallery-col) {
      gap: 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-grid[data-ready="true"] {
      transition: none;
    }

    .gallery-open:hover .gallery-photo,
    .gallery-open:focus-visible .gallery-photo {
      transform: none;
    }
  }
</style>
