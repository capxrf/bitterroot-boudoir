---
import BaseLayout from "../layouts/BaseLayout.astro";

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = formspreeId
  ? `https://formspree.io/f/${formspreeId}`
  : "";
---

<BaseLayout
  title="Contact"
  description="Book a premium boudoir session with Bitterroot Boudoir in Stevensville, Montana."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">Contact</p>
      <h1 class="reveal reveal-delay-1">Let's plan your session.</h1>
      <p class="lede reveal reveal-delay-2">
        Share a little about yourself and what you're hoping for. I'll follow up
        to talk through timing, packages, and next steps.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap contact-grid">
      <aside class="contact-aside">
        <h2>Details</h2>
        <p>
          Based in Stevensville, MT<br />
          Serving the Bitterroot Valley & surrounding areas
        </p>
        <p>
          Prefer email or phone?<br />
          <a href="mailto:hello@bitterrootboudoir.com">hello@bitterrootboudoir.com</a><br />
          <a href="tel:+14062099806">(406) 209-9806</a>
        </p>
      </aside>

      <form
        class="contact-form"
        method="POST"
        action={formAction || undefined}
        data-formspree-ready={formAction ? "true" : "false"}
      >
        <input type="hidden" name="_subject" value="New Bitterroot Boudoir inquiry" />
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" />

        {
          !formAction && (
            <p class="form-banner" role="status">
              Formspree is not configured yet. Add
              <code>PUBLIC_FORMSPREE_ID</code> to <code>.env</code> (see
              <code>.env.example</code>), then restart the dev server.
            </p>
          )
        }

        <div class="name-row">
          <label>
            <span>First name</span>
            <input
              type="text"
              name="first_name"
              required
              autocomplete="given-name"
            />
          </label>

          <label>
            <span>Last name</span>
            <input
              type="text"
              name="last_name"
              required
              autocomplete="family-name"
            />
          </label>
        </div>

        <label>
          <span>Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
            maxlength="254"
            pattern="^[^\s@]+@[^\s@]+\.[^\s@]{2,}$"
            title="Enter a valid email address (example: name@email.com)"
          />
        </label>

        <label>
          <span>Phone <em>(optional)</em></span>
          <input
            type="tel"
            name="phone"
            data-phone-format
            autocomplete="tel"
            inputmode="tel"
            maxlength="14"
            placeholder="(406) 555-1234"
            pattern="^\(\d{3}\) \d{3}-\d{4}$"
            title="Enter a 10-digit US phone number"
          />
        </label>

        <label>
          <span>Package interest</span>
          <select name="package">
            <option value="Not sure yet">Not sure yet</option>
            <option value="Essential">Essential</option>
            <option value="Signature">Signature</option>
            <option value="Heirloom">Heirloom</option>
            <option value="Custom / something specific">Custom / something specific</option>
          </select>
        </label>

        <label>
          <span>Hair &amp; makeup</span>
          <select name="hair_makeup">
            <option value="Our artist (recommended)">Our artist (recommended) — $150</option>
            <option value="I'll arrive camera-ready">I'll arrive camera-ready</option>
            <option value="Bringing my own artist">Bringing my own artist</option>
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </label>

        <label>
          <span>Tell me about your vision <em>(25+ characters)</em></span>
          <textarea
            name="message"
            rows="6"
            required
            minlength="25"
            maxlength="5000"
          ></textarea>
        </label>

        <button class="btn btn-primary" type="submit" disabled={!formAction}>
          Send inquiry
        </button>

        <p class="form-privacy">
          I use your details to reply to this inquiry. I may also use your email
          or phone for occasional studio updates — you can opt out anytime.
          Nothing is sold. See the
          <a href="/privacy">privacy notice</a>.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-md);
  }

  .contact-aside {
    max-width: 28rem;
  }

  .contact-aside h2 {
    margin-bottom: 0.5em;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .form-banner {
    margin: 0;
    padding: 0.85rem 1rem;
    background: rgba(var(--accent-rgb), 0.1);
    border: 1px solid rgba(var(--accent-rgb), 0.28);
    font-size: 0.95rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
    font-weight: 500;
  }

  label em {
    font-style: normal;
    font-weight: 400;
    color: var(--ink-soft);
  }

  .name-row {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 560px) {
    .name-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    padding: 0.8rem 0.9rem;
    font: inherit;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid rgba(var(--accent-rgb), 0.4);
    outline-offset: 1px;
    border-color: rgba(var(--accent-rgb), 0.5);
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
  }

  .form-privacy {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .form-privacy a {
    color: var(--accent);
    text-decoration-color: rgba(var(--accent-rgb), 0.45);
  }

  code {
    font-size: 0.9em;
  }

  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
      align-items: start;
    }
  }
</style>

<script>
  const phoneInput = document.querySelector("[data-phone-format]");

  const formatPhone = (value) => {
    let digits = value.replace(/\D/g, "");
    if (digits.length === 11 && digits.startsWith("1")) {
      digits = digits.slice(1);
    }
    digits = digits.slice(0, 10);

    if (digits.length === 0) return "";
    if (digits.length < 4) return `(${digits}`;
    if (digits.length < 7) {
      return `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
    }
    return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
  };

  phoneInput?.addEventListener("input", () => {
    const formatted = formatPhone(phoneInput.value);
    phoneInput.value = formatted;
  });
</script>
